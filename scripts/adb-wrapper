#!/usr/bin/env bash
# corral adb wrapper: enforces leasing at exec time. Complements the Claude PreToolUse hook —
# the hook catches absolute-path adb calls, this shim catches PATH-resolved ones.
# Install: cp scripts/adb-wrapper ~/bin/adb && chmod +x ~/bin/adb   (~/bin must precede the SDK dir on PATH)
# Needs bash 4+ (case-modifier expansions); stock macOS /bin/bash is 3.2 — install a newer bash first.
# Guard before the first ${var,,} so a 3.2 host gets this sentence, not a parse error.
if [ "${BASH_VERSINFO:-0}" -lt 4 ]; then
  printf 'corral: adb-wrapper needs bash 4+ (found %s); stock macOS /bin/bash is 3.2 — install a newer bash first.\n' \
    "${BASH_VERSION:-unknown}" >&2
  exit 1
fi
set -u
CORRAL_URL=${CORRAL_URL:-http://127.0.0.1:8798}
# the real adb: explicit CORRAL_REAL_ADB, else the adb.real sibling when this script is
# installed as the SDK shim (platform-tools/adb), else the default SDK path.
REAL_ADB=${CORRAL_REAL_ADB:-}
if [[ -z "$REAL_ADB" ]]; then
  if [[ -x "$(dirname "$0")/adb.real" ]]; then REAL_ADB="$(dirname "$0")/adb.real"
  elif [[ -x "$HOME/Android/Sdk/platform-tools/adb.real" ]]; then REAL_ADB="$HOME/Android/Sdk/platform-tools/adb.real"
  else REAL_ADB="$HOME/Android/Sdk/platform-tools/adb"; fi
fi
# Lease owner identity — the declared corral identifier wins, else process ancestry
# (see agent-session-identity.md):
#   CORRAL_OWNER > proc:<comm>:<pid>:<starttime> (process ancestry, universal) > user:$USER
# identity walk lists: built-in defaults; the rules file's shell_skip/init_floor override them
shell_list=" bash sh zsh fish dash ksh env nohup timeout xargs sudo setsid stdbuf script cmd cmd.exe powershell powershell.exe pwsh pwsh.exe conhost conhost.exe "
init_list=" systemd init services services.exe wininit wininit.exe lsass lsass.exe svchost svchost.exe winlogon winlogon.exe system explorer explorer.exe "

# Membership key for the identity lists: lowercased basename with ONE trailing `.exe` stripped.
# Windows reports `bash.exe` where the lists spell `bash`; the same rule is in AgentIdentity.kt
# (commKey), so either spelling matches and a list may be written once per program, not per
# platform. Applied to BOTH sides below — the configured entries and the walked comm.
comm_key() { local c=${1,,}; printf '%s' "${c%.exe}"; }
normalize_list() { local out='' w; for w in $1; do out+=" $(comm_key "$w")"; done; printf '%s' "$out"; }

# Gate rules: CORRAL_RULES override, else ~/.config/corral/rules. Missing/blank -> fail closed.
# The lists are the single source of truth shared with `corral gate` (see scripts/corral-rules).
CORRAL_RULES=${CORRAL_RULES:-$HOME/.config/corral/rules}
if [[ ! -r "$CORRAL_RULES" || ! -s "$CORRAL_RULES" ]]; then
  printf 'corral: gate rules missing at %s — failing closed. Re-run install.sh or start the daemon to self-heal.\n' "$CORRAL_RULES" >&2
  exit 1
fi
readonly_list=""; valueflags=""
while IFS='=' read -r k v || [[ -n $k || -n $v ]]; do
  k=${k%$'\r'}; v=${v%$'\r'}          # tolerate CRLF (the file can be edited on Windows); bash 4+
  k=${k#"${k%%[![:space:]]*}"}; k=${k%"${k##*[![:space:]]}"}
  k=${k,,}                             # keys are case-insensitive, matching the Kotlin loader
  [[ -z $k || $k == \#* ]] && continue
  v=${v%%#*}
  v=${v//,/ }; v=${v//$'\t'/ }
  v=${v#"${v%%[![:space:]]*}"}; v=${v%"${v##*[![:space:]]}"}
  case $k in
    readonly) readonly_list=" $v ";; valueflags) valueflags=" $v ";;
    # blank identity keys keep the built-in defaults, matching the Kotlin loader; identity
    # entries are lowercased to match the lowercased comm, as the Kotlin loader does
    shell_skip) [[ -n $v ]] && shell_list=" ${v,,} ";; init_floor) [[ -n $v ]] && init_list=" ${v,,} ";;
  esac
done < "$CORRAL_RULES"

# Key both sides of the identity membership tests (see comm_key): an installed rules file that
# spells the POSIX shells without `.exe` still skips a Windows `bash.exe`, and a hand-edited
# `bash.exe` entry still skips a bare `bash`. The padding keeps the `*" $key "*` match exact.
shell_list=" $(normalize_list "$shell_list") "
init_list=" $(normalize_list "$init_list") "

# Walk up the process tree from $PPID; the first non-shell ancestor is the agent.
# /proc only (Linux): comm and starttime there match the CLI byte for byte. Where /proc is
# unreadable (macOS/Windows hosts) this shell cannot walk — it delegates to `corral owner`,
# whose ProcessHandle walk is the same chain the CLI's own claims use, so both readers
# still agree (one JVM spawn per adb call); without corral it degrades to user:$USER.
# PROC_ROOT is injectable so the suite can simulate a /proc-less host.
PROC_ROOT=${CORRAL_PROC_ROOT:-/proc}
agent_process() {
  local pid="${1:-$PPID}" comm ppid start depth=0 key
  while [ "$pid" -gt 1 ]; do
    [ $((++depth)) -gt 128 ] && return 1  # parity with the CLI's MAX_ANCESTRY_DEPTH cap
    read -r comm ppid start < <(
      awk '{ c = $2; gsub(/[()]/, "", c); print c, $4, $22 }' "$PROC_ROOT/$pid/stat"
    ) || return 1
    key=$(comm_key "$comm")                # one rule for both sides, parity with the CLI's commKey
    case "$init_list" in
      *" $key "*) return 1;;              # hit init — no agent above us; fall back to user:$USER
    esac
    case "$shell_list" in
      *" $key "*) ;;                       # a shell or wrapper — keep walking (case/`.exe`-insensitive)
      *) echo "$pid $start $comm"; return 0;;
    esac
    pid="$ppid"
  done
  return 1
}

# Resolve the corral CLI from PATH entries only, to an absolute path. Empty, "." and relative
# entries are aliases for the current directory; skipping them stops a planted ./corral from
# being adopted as the CLI (command -v would honour them).
resolve_cli() {
  local dir; local -a entries
  IFS=: read -ra entries <<< "${PATH:-}"
  for dir in "${entries[@]}"; do
    [[ -z $dir || $dir == . || $dir != /* ]] && continue
    if [[ -x "$dir/corral" ]]; then printf '%s\n' "$dir/corral"; return 0; fi
  done
  return 1
}

if [[ -n ${CORRAL_OWNER:-} ]]; then OWNER=$CORRAL_OWNER
elif [[ -r "$PROC_ROOT/self/stat" ]] && read -r apid astart acomm < <(agent_process); then
  OWNER="proc:$acomm:$apid:$astart"
elif [[ ! -r "$PROC_ROOT/self/stat" ]] && cli=$(resolve_cli) &&
     o=$("$cli" owner 2>/dev/null) && [[ -n "$o" ]]; then
  OWNER=$o
else OWNER="user:${USER:-$(id -un)}"; fi

serial=${ANDROID_SERIAL:-}
# read-only subcommands that touch no device pass through without a pin (see scripts/corral-rules)
sub=""; args=("$@")
while [[ $# -gt 0 ]]; do
  case $1 in
    -s) serial=${2:-}; shift $(( $# > 1 ? 2 : 1 ));;
    -s?*) serial=${1#-s}; shift;;
    -*) if [[ " $valueflags " == *" $1 "* ]]; then shift $(( $# > 1 ? 2 : 1 )); else shift; fi;;
    *) [[ -z $sub ]] && sub=$1; shift;;
  esac
done

deny() { printf 'corral: %s\nLease it first:\n  corral lease -- <cmd>\n  ser=$(corral claim) && ANDROID_SERIAL=$ser <cmd>\nstatus: corral status\n' "$1" >&2; exit 1; }

# The daemon runs as a user systemd unit on POSIX, a per-user Scheduled Task on Windows; naming
# systemctl on Windows is a dead end (the CLI's doctor prints the same platform-appropriate hint).
daemon_hint() {
  case "$(uname -s 2>/dev/null || true)" in
    MINGW*|MSYS*|CYGWIN*) printf 'schtasks /query /tn CorralDaemon' ;;
    *) printf 'systemctl --user status corral' ;;
  esac
}

if [[ -n $serial ]]; then
  resp=$(curl -sfG --max-time 5 --data-urlencode "serial=$serial" --data-urlencode "owner=$OWNER" "$CORRAL_URL/api/check" 2>/dev/null) \
    || deny "daemon unreachable at $CORRAL_URL — failing closed (no daemon, no leasing). Start it: $(daemon_hint)"
  grep -q '"allowed":true' <<<"$resp" || deny "lease check failed for $serial: $resp"
elif [[ -n $sub ]] && [[ ! $readonly_list == *" $sub "* ]]; then
  deny "no device pinned (no -s, no ANDROID_SERIAL)"
fi
exec "$REAL_ADB" "${args[@]}"
