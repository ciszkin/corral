[Unit]
Description=Corral daemon

[Service]
Environment=PATH=%h/.sdkman/candidates/java/current/bin:%h/bin:/usr/bin:/bin
Environment=CORRAL_ADB=%h/Android/Sdk/platform-tools/adb
EnvironmentFile=-%h/.config/corral/daemon.env
# The java path below is only a fallback: install.sh rewrites it with the java it actually
# detected. SDKMAN! is not required -- JAVA_HOME or any java on PATH is fine.
ExecStart=%h/.sdkman/candidates/java/current/bin/java -Xms24m -Xmx64m -XX:+UseSerialGC -XX:MaxMetaspaceSize=64m -XX:ReservedCodeCacheSize=64m -XX:TieredStopAtLevel=1 -jar %h/.corral/corral-daemon-all.jar
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
